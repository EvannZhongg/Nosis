{
  "max_same_tool_calls": 5,
  "max_output_tokens": 8192,
  "shell_timeout_seconds": 60,
  "context": {
    "compression": {
      "enabled": true,
      "trigger_ratio": null,
      "target_ratio": null
    }
  },
  "main_agent": {
    "tools": {
      "read_file": true,
      "edit_file": true,
      "search_files": true,
      "list_directory": true,
      "shell": true,
      "web_search": false,
      "subagent": true
    }
  },
  "subagent_roles": {
    "researcher": {
      "enabled": true,
      "description": "Read and search the workspace to answer a question. Cannot modify files.",
      "tools": {
        "read_file": true,
        "search_files": true,
        "list_directory": true
      }
    },
    "coder": {
      "enabled": true,
      "description": "Implement a self-contained change in the workspace.",
      "tools": {
        "read_file": true,
        "edit_file": true,
        "search_files": true,
        "list_directory": true,
        "shell": true
      }
    }
  },
  "mcp": {
    "enabled": false,
    "servers": {}
  }
}

{
  "max_same_tool_calls": 5,
  "output_reserve_tokens": 8192,
  "max_generation_tokens": null,
  "workspace_instruction_files": [
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "context": {
    "compression": {
      "enabled": true,
      "trigger_ratio": null,
      "keep_recent_units": 8
    }
  },
  "main_agent": {
    "tools": {
      "read_file": true,
      "edit_file": true,
      "write_file": true,
      "search_files": true,
      "list_directory": true,
      "shell": true,
      "web_search": false,
      "subagent": true,
      "create_scheduled_task": true,
      "update_scheduled_task": true,
      "list_scheduled_tasks": true
    }
  },
  "subagent_roles": {
    "researcher": {
      "enabled": true,
      "description": "Read and search the workspace to answer a question. Prefer delegating complex, independent investigation tasks to this role so the main agent can continue other work in parallel. Cannot modify files.",
      "tools": {
        "read_file": true,
        "search_files": true,
        "list_directory": true
      }
    }
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  }
}

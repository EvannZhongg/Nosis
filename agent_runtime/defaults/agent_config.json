{
  "max_same_tool_calls": 5,
  "output_reserve_tokens": 8192,
  "max_generation_tokens": null,
  "provider": {
    "request_timeout_seconds": 300,
    "max_retries": 2
  },
  "scratch_workspace_root": "~/.nosis/workspaces/scratch",
  "workspace_instruction_files": [
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "skills": {
    "global_paths": [
      "~/.nosis/skills"
    ],
    "workspace_paths": [
      "skills",
      ".agents/skills",
      ".nosis/skills"
    ]
  },
  "context": {
    "compression": {
      "enabled": true,
      "trigger_ratio": null,
      "keep_recent_units": 8
    }
  },
  "main_agent": {
    "tools": {
      "read_file": true,
      "apply_patch": true,
      "edit_file": true,
      "write_file": true,
      "generate_image": false,
      "search_files": true,
      "list_directory": true,
      "shell": true,
      "web_search": false,
      "web_fetch": true,
      "subagent": true,
      "scheduled_task": true,
      "computer_screenshot": true,
      "computer_action": true
    }
  },
  "subagent_roles": {
    "researcher": {
      "enabled": true,
      "description": "Read and search the workspace to answer a question. Prefer delegating complex, independent investigation tasks to this role so the main agent can continue other work in parallel. Cannot modify files.",
      "tools": {
        "read_file": true,
        "search_files": true,
        "list_directory": true
      }
    }
  },
  "memory": {
    "enabled": true,
    "global_max_tokens": 2000,
    "workspace_max_tokens": 3000
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  }
}
